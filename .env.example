# Copy to .env.local and fill in. Never commit .env.local.
#
# Names only — no values, not even sample ones. A placeholder that looks
# like a connection string is one careless copy away from being mistaken
# for a real one, and an example that drifts out of date is worse than
# no example at all. What each variable needs is described above it.
#
# Each environment (dev / qa / stage / prod) should get its own Neon
# branch, so a bad migration in dev can never touch production data.

# Neon, pooled connection — used by the app at runtime.
# The one whose host contains "-pooler".
DATABASE_URL=

# Neon, direct connection — used by prisma migrate only.
# The same host WITHOUT "-pooler". Migrations cannot run through the
# pooled endpoint.
DIRECT_URL=

# Which environment this deployment represents.
# One of: dev | qa | stage | prod. Anything unrecognised reads as dev.
APP_ENV=

# 32+ random bytes. Despite the name it does not touch session cookies —
# those are random tokens, stored as SHA-256, with no secret involved.
# This is the HMAC key for the six-digit reset and verification codes.
#
# It matters because six digits is only a million possibilities: a plain
# hash of one is a table an attacker can precompute in seconds, so a
# leaked verification_codes table would hand over every pending code.
# Keyed with a secret only the server has, that table is useless alone.
#
# Use a different value per environment, and never reuse dev's in prod.
# Changing it invalidates pending codes, not sessions.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Public base URL of this deployment, used for links in emails.
# In development this is the local dev server's address.
NEXT_PUBLIC_APP_URL=

# Resend API key, from https://resend.com/api-keys
# Leave empty in development: mail is written to .mail/ instead of being
# sent, so the reset and verification flows work before a domain exists.
RESEND_API_KEY=

# Sender address, in "Name <address>" form. Must be on a domain verified
# in Resend — until it is, Resend only delivers to the account owner.
EMAIL_FROM=

# Restricted Postgres role for the admin portal — see docs/ADMIN.md.
# A different role from DATABASE_URL, with SELECT on metadata columns and
# nothing else. The portal refuses to run without it rather than falling
# back to the application's connection, because a seal that opens when
# misconfigured is not a seal.
ADMIN_DATABASE_URL=

# The one owner of the admin portal, by email address.
# Deliberately not a database row: everything below owner is granted by
# invitation, but reaching the top itself requires deploy access rather
# than a SQL UPDATE. A role table that can mint its own root is not a
# boundary.
SUPER_ADMIN_EMAIL=

# Reads what people wrote — and nothing else. A third Postgres role, used
# by exactly one code path, which refuses unless the account holder has an
# approved, unexpired, unrevoked consent record for that exact scope.
# See docs/ADMIN.md. Without it, support access refuses rather than
# falling back to a connection that would work.
SUPPORT_DATABASE_URL=
