# Copy to .env.local and fill in. Never commit .env.local.
# Each environment (dev / qa / stage / prod) gets its own Neon branch,
# so a bad migration in dev can never touch production data.

# Neon — pooled connection, used by the app at runtime.
# Host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/krama?sslmode=require"

# Neon — direct connection, used by prisma migrate only.
# Same host WITHOUT "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/krama?sslmode=require"

# Which environment this deployment represents: dev | qa | stage | prod
APP_ENV="dev"

# 32+ random bytes, used to sign session cookies.
# Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Public base URL, used for links in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
